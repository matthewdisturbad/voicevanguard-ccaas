# Variáveis do serviço de TESTE no Railway (não use o serviço de produção).
# Sem valores reais aqui: gere as chaves e cole direto no painel do Railway.
NODE_ENV=production
# Conteúdo de tenants.example.json em UMA linha, com as chaves reais:
#   jq -c . tenants.json
TENANTS_JSON=
# Atrás do proxy do Railway (rate limit usa o IP real)
TRUST_PROXY=1
# Caminho de um Volume montado no serviço (histórico sobrevive a redeploy)
DATA_DIR=/data
# PORT é definida pelo Railway; não configurar.
