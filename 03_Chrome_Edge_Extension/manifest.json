{
  "manifest_version": 3,
  "name": "VoiceVanguard • CCaaS WebRTC Sentinel",
  "version": "1.0.0",
  "description": "Observabilidade de voz e auditoria de MOS (aproximação ITU-T G.107) para Genesys Cloud CX e Amazon Connect. Coleta apenas estatísticas de rede; não captura áudio.",
  "author": "TrustCo Technologies",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "VoiceVanguard Universal Sentinel"
  },
  "permissions": [
    "storage",
    "alarms",
    "browsingData"
  ],
  "host_permissions": [
    "https://*.pure.cloud/*",
    "https://*.mypurecloud.com/*",
    "https://*.mypurecloud.com.au/*",
    "https://*.mypurecloud.ie/*",
    "https://*.mypurecloud.de/*",
    "https://*.mypurecloud.jp/*",
    "https://*.my.connect.aws/*",
    "https://*.awsapps.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.pure.cloud/*",
        "https://*.mypurecloud.com/*",
        "https://*.mypurecloud.com.au/*",
        "https://*.mypurecloud.ie/*",
        "https://*.mypurecloud.de/*",
        "https://*.mypurecloud.jp/*",
        "https://*.my.connect.aws/*",
        "https://*.awsapps.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected_webrtc_hook.js"
      ],
      "matches": [
        "https://*.pure.cloud/*",
        "https://*.mypurecloud.com/*",
        "https://*.mypurecloud.com.au/*",
        "https://*.mypurecloud.ie/*",
        "https://*.mypurecloud.de/*",
        "https://*.mypurecloud.jp/*",
        "https://*.my.connect.aws/*",
        "https://*.awsapps.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
