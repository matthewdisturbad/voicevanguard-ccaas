{
  "manifest_version": 3,
  "name": "VoiceVanguard CCaaS",
  "version": "1.0.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "author": "TrustCo Technologies",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "__MSG_extActionTitle__"
  },
  "permissions": [
    "storage",
    "browsingData"
  ],
  "host_permissions": [
    "https://*.pure.cloud/*",
    "https://*.mypurecloud.com/*",
    "https://*.mypurecloud.com.au/*",
    "https://*.mypurecloud.ie/*",
    "https://*.mypurecloud.de/*",
    "https://*.mypurecloud.jp/*",
    "https://*.my.connect.aws/*",
    "https://*.awsapps.com/connect/*",
    "https://*.niceincontact.com/*",
    "https://*.nice-incontact.com/*",
    "https://desktop.wxcc-us1.cisco.com/*",
    "https://desktop.wxcc-eu1.cisco.com/*",
    "https://desktop.wxcc-sg1.cisco.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.pure.cloud/*",
        "https://*.mypurecloud.com/*",
        "https://*.mypurecloud.com.au/*",
        "https://*.mypurecloud.ie/*",
        "https://*.mypurecloud.de/*",
        "https://*.mypurecloud.jp/*",
        "https://*.my.connect.aws/*",
        "https://*.awsapps.com/connect/*",
        "https://*.niceincontact.com/*",
        "https://*.nice-incontact.com/*",
        "https://desktop.wxcc-us1.cisco.com/*",
        "https://desktop.wxcc-eu1.cisco.com/*",
        "https://desktop.wxcc-sg1.cisco.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected_webrtc_hook.js"
      ],
      "matches": [
        "https://*.pure.cloud/*",
        "https://*.mypurecloud.com/*",
        "https://*.mypurecloud.com.au/*",
        "https://*.mypurecloud.ie/*",
        "https://*.mypurecloud.de/*",
        "https://*.mypurecloud.jp/*",
        "https://*.my.connect.aws/*",
        "https://*.awsapps.com/*",
        "https://*.niceincontact.com/*",
        "https://*.nice-incontact.com/*",
        "https://desktop.wxcc-us1.cisco.com/*",
        "https://desktop.wxcc-eu1.cisco.com/*",
        "https://desktop.wxcc-sg1.cisco.com/*"
      ]
    }
  ],
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "background": {
    "service_worker": "background.js"
  }
}
